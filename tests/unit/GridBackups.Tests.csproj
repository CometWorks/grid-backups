<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the plugin's logic that runs without a game: storage paths,
       backup triggers, retention, grid name matching and folder names.
       Directory.Build.props of the repository finds the Dedicated Server and
       Magnetar, the same way the plugin build does. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../ServerPlugin/ServerPlugin.csproj" />
    <!-- Magnetar provides PluginSdk to the plugin; the tests need a copy -->
    <Reference Include="PluginSdk">
      <HintPath>$(MagnetarBinDir)PluginSdk.dll</HintPath>
    </Reference>
    <!-- MyFileSystem, for the server's data folder -->
    <Reference Include="VRage.Library">
      <HintPath>$(Dedicated64Dir)VRage.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The game assemblies stay where they are; GameAssemblies in UnitTests.cs loads them from here -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Dedicated64</_Parameter1>
      <_Parameter2>$(Dedicated64Dir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
